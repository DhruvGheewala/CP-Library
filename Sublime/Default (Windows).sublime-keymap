[
	{
		"keys": ["ctrl+b"],
		"command":"build"
	},

	// Needs the CFCompiler package, which is not on Package Control -- it is a
	// user-defined package, so this key does nothing on a fresh install.
	{
		"keys": ["ctrl+alt+b"],
		"command":"cfcompiler"
	},

	{
		"keys": ["ctrl+alt+c"],
		"command":"cancel_build"
	},

	// Same as above: "Quote" is user-defined, not a Package Control package.
	{
		"keys": ["ctrl+alt+s"],
		"command": "quote"
	},

	{
		"keys": ["ctrl+alt+p"],
		"command": "toggle_side_bar"
	},

	{
		"keys": ["ctrl+alt+n"],
		"command": "new_snippet"
	},

	{
		"keys": ["ctrl+alt+o"],
		"command": "open_dir",
		"args": {"dir": "$packages"}
	},

	{
		"keys": ["ctrl+shift+o"],
		"command": "open_file",
		"args": {"file": "${packages}/User/Template-cbase-Snippet.sublime-snippet"}
	},

	{
		"keys": ["ctrl+alt+i"],
		"command": "coolformat",
		"args": {"action": "quickFormat"}
	},

	{
		"keys": ["ctrl+alt+shift+c"],
        "command": "sublime_highlight",
        "args" : {
            "target": "clipboard",
            "output_type": "html"
        }
	},

	{
		"keys": ["ctrl+alt+shift+s"],
        "command": "sublime_highlight",
        "args" : {
            "target": "external",
            "output_type": "html"
        }
	},
]
